---
import SectionHeading from './SectionHeading.astro';
import { content } from '../data';

const { contact } = content;
const meta = content.sections.contact;

const actions = contact.actions.filter((action) => action.href !== null);
const actionClass =
  'inline-block rounded-sm border border-border px-4 py-2 font-medium text-accent hover:border-accent';
---

<section id={meta.id} class="mx-auto max-w-content px-6 py-section">
  <SectionHeading meta={meta} />

  <p class="mt-8 max-w-[50ch] text-lead">{contact.opening}</p>

  <ul class="mt-10 flex flex-wrap gap-3">
    {
      actions.map((action) => (
        <li>
          <a class={actionClass} href={action.href}>
            {action.label}
          </a>
        </li>
      ))
    }
    <li>
      <button class={actionClass} type="button" data-email hidden>
        {contact.emailLabel}
      </button>
    </li>
  </ul>

  <p class="mt-16">
    <a class="font-mono text-mono uppercase tracking-widest text-text-muted" href="#top">
      {content.backToTop}
    </a>
  </p>
</section>

<script>
  import { encodedEmail } from '../data/email';

  // The address is decoded at click time: it never reaches the HTML in readable
  // form. Without JavaScript the button stays hidden and the other links remain.
  const button = document.querySelector<HTMLButtonElement>('[data-email]');

  if (button) {
    button.hidden = false;
    button.addEventListener('click', () => {
      window.location.href = `mailto:${atob(encodedEmail)}`;
    });
  }
</script>
