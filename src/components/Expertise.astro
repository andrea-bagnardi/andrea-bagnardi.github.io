---
import SectionHeading from './SectionHeading.astro';
import { content } from '../data';

const { expertise } = content;
const meta = content.sections.expertise;

/** Splits the evidence around the {counter} token so the number can be marked up. */
function splitEvidence(evidence: string): [string, string] {
  const [before, after = ''] = evidence.split('{counter}');
  return [before, after];
}
---

<section id={meta.id} class="mx-auto max-w-content px-6 py-section">
  <SectionHeading meta={meta} />

  <div class="mt-12 grid gap-6 md:grid-cols-2">
    {
      expertise.cards.map((card) => {
        const [before, after] = splitEvidence(card.evidence);
        return (
          <article class="rounded-md border border-border bg-surface p-6 sm:p-8" data-field-boost>
            <h3 class="text-h3 font-display font-medium">{card.title}</h3>
            <p class="mt-4 font-medium">{card.claim}</p>
            <p class="mt-3 text-small text-text-muted">
              {card.counter ? (
                <>
                  {before}
                  <span class="font-mono font-medium text-text" data-counter={card.counter.to}>
                    {card.counter.display}
                  </span>
                  {after}
                </>
              ) : (
                card.evidence
              )}
            </p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {card.tags.map((tag) => (
                <li class="rounded-sm border border-border px-2 py-1 font-mono text-mono text-text-muted">
                  {tag}
                </li>
              ))}
            </ul>
          </article>
        );
      })
    }
  </div>

  <p class="mt-6 rounded-md border border-border p-6 text-small text-text-muted sm:p-8">
    {expertise.crossCutting}
  </p>
</section>
