---
import SectionHeading from './SectionHeading.astro';
import { getContent } from '../data';

const content = getContent(Astro.currentLocale);
const { projects, labels } = content;
const meta = content.sections.projects;
---

<section id={meta.id} class="mx-auto max-w-content px-6 py-section">
  <SectionHeading meta={meta} />

  <div class="mt-12 space-y-24">
    {
      projects.map((project) => {
        const actions = project.actions.filter((action) => action.href !== null);
        const { poster, posterSmall } = project.preview;
        const srcset = posterSmall ? `${posterSmall} 640w, ${poster} 1280w` : undefined;
        return (
          <article class="grid gap-10 lg:grid-cols-2 lg:gap-16">
            <div class="lg:sticky lg:top-12 lg:self-start" data-reveal>
              <p class="font-mono text-mono uppercase tracking-widest text-accent">
                {project.eyebrow}
              </p>
              <h3 class="mt-3 text-h2 font-display font-semibold">{project.name}</h3>

              <dl class="mt-8 space-y-6">
                <div>
                  <dt class="font-mono text-mono uppercase tracking-widest text-text-muted">
                    {labels.problem}
                  </dt>
                  <dd class="mt-2">{project.problem}</dd>
                </div>
                <div>
                  <dt class="font-mono text-mono uppercase tracking-widest text-text-muted">
                    {labels.solution}
                  </dt>
                  <dd class="mt-2">{project.solution}</dd>
                </div>
                <div>
                  <dt class="font-mono text-mono uppercase tracking-widest text-text-muted">
                    {labels.decisions}
                  </dt>
                  <dd class="mt-2">
                    <ul class="space-y-2">
                      {project.decisions.map((decision) => (
                        <li class="text-text-muted">{decision}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              </dl>

              {project.method && (
                <p class="mt-8 border-l-2 border-accent pl-4 text-small">{project.method}</p>
              )}

              {actions.length > 0 && (
                <ul class="mt-8 flex flex-wrap gap-3">
                  {actions.map((action) => (
                    <li>
                      <a
                        class="inline-block rounded-sm border border-border px-4 py-2 font-medium text-accent hover:border-accent"
                        href={action.href}
                      >
                        {action.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="space-y-8" data-reveal>
              {/* Explicit dimensions on both branches, so swapping the
                   placeholder for real artwork never moves the layout.
                   494px is the preview column once the grid splits: the 1100px
                   centre column, less the 24px gutters, less the 64px gap,
                   halved. Below that breakpoint the image is the full width
                   minus the same gutters. */}
              {poster ? (
                <img
                  class="aspect-video w-full rounded-md border border-border bg-surface"
                  src={poster}
                  srcset={srcset}
                  sizes="(min-width: 1024px) 494px, calc(100vw - 3rem)"
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                  alt={project.preview.alt}
                />
              ) : (
                <div
                  class="flex aspect-video w-full items-center justify-center rounded-md border border-border bg-surface"
                  aria-hidden="true"
                >
                  <span class="font-mono text-mono text-text-muted">{labels.previewPending}</span>
                </div>
              )}

              <dl class="grid grid-cols-3 gap-6">
                {project.stats.map((stat) => (
                  <div class="flex flex-col-reverse gap-1">
                    <dt class="text-small text-text-muted">{stat.label}</dt>
                    <dd class="font-mono text-h2 font-medium text-signal">{stat.value}</dd>
                  </div>
                ))}
              </dl>

              <div>
                <h4 class="font-mono text-mono uppercase tracking-widest text-text-muted">
                  {labels.technologies}
                </h4>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {project.stack.map((item) => (
                    <li class="rounded-sm border border-border px-2 py-1 font-mono text-mono text-text-muted">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
