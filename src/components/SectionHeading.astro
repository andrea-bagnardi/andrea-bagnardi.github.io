---
import type { SectionMeta } from '../data';

interface Props {
  meta: SectionMeta;
}

const { meta } = Astro.props;
---

<header data-reveal>
  <p class="font-mono text-mono uppercase tracking-widest text-text-muted">
    {meta.index} / {meta.label}
  </p>
  <h2 class="mt-3 text-h2 font-display font-semibold">{meta.title}</h2>
</header>
