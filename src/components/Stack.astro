---
import SectionHeading from './SectionHeading.astro';
import { content } from '../data';

const { stack } = content;
const meta = content.sections.stack;
---

<section id={meta.id} class="mx-auto max-w-content px-6 py-section">
  <SectionHeading meta={meta} />

  <div class="mt-12 grid grid-cols-2 gap-8 md:grid-cols-4">
    {
      stack.groups.map((group) => (
        <div data-field-boost>
          <h3 class="font-mono text-mono uppercase tracking-widest text-text-muted">
            {group.title}
          </h3>
          <ul class="mt-4 space-y-2">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mt-12 border-t border-border pt-8">
    <h3 class="font-mono text-mono uppercase tracking-widest text-text-muted">
      {stack.personal.title}
    </h3>
    <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-2">
      {stack.personal.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>
