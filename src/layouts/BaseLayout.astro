---
import '../styles/global.css';

// Fonts used above the fold: preloaded so the hero name does not wait for the
// stylesheet to be parsed. The other faces load on demand.
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource/inter-tight/files/inter-tight-latin-400-normal.woff2?url';

import HeroIntroFlag from '../components/HeroIntroFlag.astro';
import LanguageRedirect from '../components/LanguageRedirect.astro';
import { defaultLocale, getContent, isLocale, localeMeta, locales } from '../data';

interface Props {
  title: string;
  description: string;
  /** Off for pages that exist only in development, and for the 404. */
  indexable?: boolean;
  /** Off for pages without a hero to reveal. */
  heroIntro?: boolean;
}

const { title, description, indexable = true, heroIntro = true } = Astro.props;

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const { meta } = getContent(locale);

// The two home pages are the only ones that have a counterpart in the other
// language, so they are the only ones that declare one or send anybody there.
const isHome = locales.some((candidate) => localeMeta[candidate].href === Astro.url.pathname);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = locale === defaultLocale ? '/og.png' : `/${locale}/og.png`;
const ogImage = new URL(shareImage, Astro.site).href;

const profiles = meta.profiles
  .filter((profile) => profile.href !== null)
  .map((profile) => profile.href as string);

// No email address here, because there is none anywhere on the site: the brief
// rules it out in every form. Only the public profiles go in.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrea Bagnardi',
  jobTitle: meta.jobTitle,
  description: meta.description,
  url: new URL(localeMeta[locale].href, Astro.site).href,
  image: ogImage,
  knowsAbout: meta.knowsAbout,
  ...(profiles.length > 0 ? { sameAs: profiles } : {}),
};
---

<!doctype html>
<html lang={meta.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Before anything is painted, and before the hero decides what to do. */}
    {isHome && locale === defaultLocale && <LanguageRedirect />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex" />}

    {
      indexable && isHome && (
        <>
          {locales.map((alternate) => (
            <link
              rel="alternate"
              hreflang={alternate}
              href={new URL(localeMeta[alternate].href, Astro.site).href}
            />
          ))}
          {/* Whoever we cannot place gets the Italian page, and its script. */}
          <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
        </>
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f6f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1216" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andrea Bagnardi" />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={meta.ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    {heroIntro && <HeroIntroFlag />}
  </head>
  <body>
    <slot />
  </body>
</html>
