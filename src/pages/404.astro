---
import BaseLayout from '../layouts/BaseLayout.astro';
import DotField from '../components/DotField.astro';
import { getContent, localeMeta, locales } from '../data';

// GitHub Pages serves this one file for every missing path, /en/ included, and
// it cannot know which language was being read. So it says it twice rather than
// guessing, and it says it without JavaScript, which a swap at runtime could
// not do.
const versions = locales.map((locale) => ({
  locale,
  home: localeMeta[locale].href,
  ...getContent(locale).notFound,
}));

const [primary] = versions;
---

<BaseLayout
  title={`${primary.title} · Andrea Bagnardi`}
  description={primary.message}
  indexable={false}
  heroIntro={false}
>
  <DotField />

  <main class="mx-auto flex min-h-[100svh] max-w-content flex-col justify-center px-6 py-section">
    <p class="font-mono text-mono uppercase tracking-widest text-text-muted">
      {primary.eyebrow}
    </p>

    <div class="mt-8 h-px w-24 bg-accent" aria-hidden="true"></div>

    {
      versions.map(({ locale, home, title, message, backLabel }, index) => (
        <section class={index > 0 ? 'mt-14' : 'mt-10'} lang={locale}>
          {/* One h1 on the page, as everywhere else: the second language is a
              heading below it, not a second title. */}
          {index === 0 ? (
            <h1 class="text-h2 font-display font-semibold">{title}</h1>
          ) : (
            <h2 class="text-h2 font-display font-semibold">{title}</h2>
          )}

          <p class="mt-4 max-w-[46ch] text-lead text-text-muted">{message}</p>

          <p class="mt-6">
            <a
              class="inline-block rounded-sm border border-border px-4 py-2 font-medium text-accent hover:border-accent"
              href={home}
              hreflang={locale}
            >
              {backLabel}
            </a>
          </p>
        </section>
      ))
    }
  </main>
</BaseLayout>
