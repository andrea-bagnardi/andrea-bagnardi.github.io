---
import BaseLayout from '../layouts/BaseLayout.astro';
import DotField from '../components/DotField.astro';
import { content } from '../data';

const { notFound } = content;
---

<BaseLayout
  title={`${notFound.title} · ${content.hero.name}`}
  description={notFound.message}
  indexable={false}
  heroIntro={false}
>
  <DotField />

  <main class="mx-auto flex min-h-[100svh] max-w-content flex-col justify-center px-6 py-section">
    <p class="font-mono text-mono uppercase tracking-widest text-text-muted">
      {notFound.eyebrow}
    </p>

    <h1 class="mt-3 text-h2 font-display font-semibold">{notFound.title}</h1>

    <div class="mt-8 h-px w-24 bg-accent" aria-hidden="true"></div>

    <p class="mt-8 max-w-[46ch] text-lead text-text-muted">{notFound.message}</p>

    <p class="mt-10">
      <a
        class="inline-block rounded-sm border border-border px-4 py-2 font-medium text-accent hover:border-accent"
        href="/"
      >
        {notFound.backLabel}
      </a>
    </p>
  </main>
</BaseLayout>

<script>
  // Only the dot field: there is no hero to reveal and nothing to watch on
  // scroll, so neither the sequence nor ScrollTrigger is loaded here.
  import { createDotField } from '../scripts/dot-field';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-dot-field]');
  if (canvas) {
    canvas.hidden = false;
    createDotField(canvas);
  }
</script>
